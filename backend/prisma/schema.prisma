generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Professor {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @unique
  passwordHash    String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  readingSessions ReadingSession[]
}

model Student {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  readingSessions ReadingSession[]
}

model ReadingSession {
  id                String             @id @default(uuid()) @db.Uuid
  professorId       String             @db.Uuid
  studentId         String             @db.Uuid
  bookRefId         String
  startedAt         DateTime           @default(now())
  completedAt       DateTime?
  professor         Professor          @relation(fields: [professorId], references: [id])
  student           Student            @relation(fields: [studentId], references: [id])
  activityResponses ActivityResponse[]
  hintUsages        HintUsage[]
  result            SessionResult?

  @@index([professorId, startedAt])
  @@index([studentId, startedAt])
}

model ActivityResponse {
  id            String         @id @default(uuid()) @db.Uuid
  sessionId     String         @db.Uuid
  activityRefId String
  attemptNumber Int            @default(1)
  isCorrect     Boolean
  answeredAt    DateTime       @default(now())
  session       ReadingSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, activityRefId, attemptNumber])
}

model HintUsage {
  id            String         @id @default(uuid()) @db.Uuid
  sessionId     String         @db.Uuid
  hintRefId     String
  activityRefId String?
  usedAt        DateTime       @default(now())
  session       ReadingSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, usedAt])
}

model SessionResult {
  sessionId        String         @id @db.Uuid
  literalScore     Int
  inferentialScore Int
  globalScore      Int?
  globalLevel      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  session          ReadingSession @relation(fields: [sessionId], references: [id])
}
